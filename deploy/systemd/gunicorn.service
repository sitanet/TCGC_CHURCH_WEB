[Unit]
Description=Gunicorn WSGI daemon for The CityGate Church Platform
After=network.target postgresql.service

[Service]
Type=notify
User=deploy
Group=www-data
WorkingDirectory=/var/www/thecitygatechurch
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
EnvironmentFile=/var/www/thecitygatechurch/.env

ExecStart=/var/www/thecitygatechurch/.venv/bin/gunicorn \
          --workers 4 \
          --threads 2 \
          --worker-class gthread \
          --worker-tmp-dir /dev/shm \
          --bind unix:/run/gunicorn.sock \
          --timeout 120 \
          --keep-alive 5 \
          --max-requests 1000 \
          --max-requests-jitter 50 \
          --access-logfile /var/log/gunicorn/access.log \
          --error-logfile /var/log/gunicorn/error.log \
          --capture-output \
          config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=15
PrivateTmp=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
