# ==============================================================================
# THE CITYGATE CHURCH - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=generate-a-secure-50-character-random-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=thecitygatechurch.org,www.thecitygatechurch.org,127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.production

# Database Settings (PostgreSQL on DigitalOcean Droplet)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tcgc_church_db
DB_USER=tcgc_user
DB_PASSWORD=your_secure_postgresql_password_here
DB_HOST=localhost
DB_PORT=5432

# Or Database URL (optional shorthand format: postgresql://tcgc_user:password@localhost:5432/tcgc_church_db)
DATABASE_URL=

# Media Storage Configuration (DigitalOcean Spaces / AWS S3)
# Set to True when using DigitalOcean Spaces or AWS S3 for sermon audio/video/PDF media
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your_spaces_access_key
AWS_SECRET_ACCESS_KEY=your_spaces_secret_key
AWS_STORAGE_BUCKET_NAME=tcgc-church-media
AWS_S3_REGION_NAME=nyc3
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=tcgc-church-media.nyc3.cdn.digitaloceanspaces.com
DO_SPACES_BUCKET=tcgc-church-media

# CORS & CSRF Trusted Origins (HTTPS in production)
CORS_ALLOWED_ORIGINS=https://thecitygatechurch.org,https://www.thecitygatechurch.org
CSRF_TRUSTED_ORIGINS=https://thecitygatechurch.org,https://www.thecitygatechurch.org

# Church Identity & Global Defaults
CHURCH_NAME="The CityGate Church"
CHURCH_TAGLINE="A place of divine encounter, spiritual growth, and kingdom impact."
CHURCH_CONTACT_EMAIL="contact@thecitygatechurch.org"
CHURCH_CONTACT_PHONE="+234 000 000 0000"
CHURCH_STREAMING_URL="https://www.youtube.com/@TheCityGateChurch"

# Production SMTP Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_api_key_or_password
DEFAULT_FROM_EMAIL="The CityGate Church <noreply@thecitygatechurch.org>"

# Optional Redis / Task Queue
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
